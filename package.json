{
  "name": "patrimoine-ia",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/build-pwa.mjs",
    "preview": "vite preview",
    "test": "node --import ./tests/register.mjs --test tests/*.test.ts",
    "check:server": "tsc --noEmit --target ES2022 --module ESNext --moduleResolution bundler --skipLibCheck netlify/functions/analyze-listing.mts netlify/functions/account.mts",
    "test:mobile": "node tests/mobile.cjs",
    "preview:qa": "node --import ./tests/register.mjs tests/server.mjs",
    "test:experience": "node tests/experience.cjs",
    "test:accounts": "node tests/accounts.cjs"
  },
  "dependencies": {
    "@netlify/blobs": "^11.1.0",
    "@netlify/functions": "^4.2.5",
    "@netlify/identity": "^2.0.0",
    "@types/leaflet": "^1.9.22",
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "recharts": "^2.12.7",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "^5.4.3"
  },
  "engines": {
    "node": ">=24"
  }
}
